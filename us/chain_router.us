      "index/vectors.db": "allow",
      "memory/pending.jsonl": "allow - staging only, never memory.md",
      "rack.md": "allow"
    },
    "net": "allow - GATED: git remotes need CHAINKIT_GIT_REMOTE=1",
    "read": {
      "*": "deny",
      "**": "allow - the whole ground, via ground_*/search",
      "agent_workspace/**": "allow"
    }
  },
  "reports_to": "chainkit",
  "source": "Research/agents/router.md",
